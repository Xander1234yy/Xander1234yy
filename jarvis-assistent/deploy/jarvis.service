# Laat Jarvis altijd draaien op een Linux-computer of Raspberry Pi.
#   1. Pas User, WorkingDirectory en de sleutels hieronder aan.
#   2. sudo cp jarvis-assistent/deploy/jarvis.service /etc/systemd/system/
#   3. sudo systemctl enable --now jarvis
#   Logboek bekijken: journalctl -u jarvis -f
[Unit]
Description=Jarvis - persoonlijke assistent
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Xander1234yy/jarvis-assistent
Environment=ANTHROPIC_API_KEY=sk-ant-...
Environment=JARVIS_PIN=123456
ExecStart=/home/pi/Xander1234yy/jarvis-assistent/.venv/bin/python -m jarvis web --telefoon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
