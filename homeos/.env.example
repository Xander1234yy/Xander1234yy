# ─────────────────────────────────────────────────────────────
# HomeOS — voorbeeldconfiguratie. Kopieer naar .env.local (nooit committen).
# Geen echte geheimen in dit bestand zetten.
# ─────────────────────────────────────────────────────────────

# ── Device Connector (apps/connector) — draait op je laptop ──
# Alleen lokaal luisteren. Zet NOOIT een poort open in je router.
HOMEOS_CONNECTOR_HOST=127.0.0.1
HOMEOS_CONNECTOR_PORT=8787
# Map voor identiteit, token, versleutelde secrets en logboeken (standaard apps/connector/.data)
# HOMEOS_DATA_DIR=
# DEMO-apparaten: standaard aan in ontwikkeling, uit in productie
# HOMEOS_DEMO=true
# Optionele hoofdsleutel (min. 32 tekens) voor de versleutelde secret-opslag.
# Zonder deze variabele maakt de connector een lokaal sleutelbestand (0600).
# HOMEOS_CONNECTOR_SECRET=
HOMEOS_POLL_INTERVAL_MS=15000
HOMEOS_RATE_LIMIT_PER_MIN=300
HOMEOS_COMMAND_LIMIT_PER_MIN=60

# ── Webapp (apps/web) — server-side only ──
HOMEOS_CONNECTOR_URL=http://127.0.0.1:8787
# In ontwikkeling leest de webapp het token automatisch uit apps/connector/.data/api-token.
# Elders: zet het token hier (server-side variabele, nooit NEXT_PUBLIC_*).
# HOMEOS_CONNECTOR_TOKEN=
# HOMEOS_CONNECTOR_TOKEN_FILE=

# ── Supabase (fase 2) ──
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # alleen server-side

# ── AI-provider voor Jarvis (fase 6) ──
# JARVIS_PROVIDER=local
# ANTHROPIC_API_KEY=                 # alleen server-side
