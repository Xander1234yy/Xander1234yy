{
  "name": "homeos",
  "version": "0.1.0",
  "private": true,
  "description": "HomeOS — Your home. One intelligent system.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @homeos/web",
    "dev:connector": "npm run dev -w @homeos/connector",
    "start:connector": "npm run start -w @homeos/connector",
    "build": "npm run build -w @homeos/web",
    "start": "npm run start -w @homeos/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @homeos/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
